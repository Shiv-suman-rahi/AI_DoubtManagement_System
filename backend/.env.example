# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URLS=http://localhost:5173,http://localhost:3000

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/aidms

# Authentication & Security
JWT_ACCESS_SECRET=aidms_super_secure_jwt_access_secret_key_2026_production
JWT_REFRESH_SECRET=aidms_super_secure_jwt_refresh_secret_key_2026_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AI Engine Configuration
# Supported providers: "gemini", "openai", "local" (automatic offline/heuristic fallback)
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004
SIMILARITY_THRESHOLD=0.78
AUTO_GROUP_THRESHOLD=0.85

# File Upload Configuration
MAX_FILE_SIZE_MB=15
UPLOAD_DIR=uploads
STORAGE_PROVIDER=local

# Institutional Defaults
DEFAULT_COLLEGE_NAME="Apex Institute of Technology"
ALLOWED_EMAIL_DOMAINS="apex.edu,student.apex.edu,faculty.apex.edu"
